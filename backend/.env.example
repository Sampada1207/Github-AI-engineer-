APP_NAME="GitHub AI Engineer API"
DEBUG=false
API_V1_STR="/api"

JWT_SECRET=your_production_jwt_secret_key_change_in_prod_1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=sqlite:///./github_ai_engineer.db

QDRANT_PATH=./qdrant_data
QDRANT_HOST=
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=code_intelligence

OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

GITHUB_TOKEN=your_github_token_here

GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour_pem_private_key_here\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_APP_INSTALLATION_ID=12345678
GITHUB_APP_ENABLED=false
GITHUB_PR_AUTOMATION_MODE=dry-run

