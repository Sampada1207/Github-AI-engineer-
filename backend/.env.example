# Copy to .env and adjust. Required for production: JWT_SECRET, DEBUG=False, CORS_ORIGINS.

DEBUG=True
API_V1_STR=/api
DATABASE_URL=sqlite:///./github_ai_engineer.db

# Required when DEBUG=False. Generate a long random string.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated frontend origins (no wildcard with credentials)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

QDRANT_PATH=./qdrant_data
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=code_intelligence

# Optional. Without these, embeddings/chat/docs use local or static fallbacks.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

CLONED_REPOS_DIR=./cloned_repos
