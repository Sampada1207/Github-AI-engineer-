# ==========================================
# GitHub AI Engineer - Environment Configuration
# ==========================================

# ----------------- App Settings -----------------
APP_NAME="GitHub AI Engineer API"
DEBUG=false
API_V1_STR="/api"

# ----------------- Security & JWT -----------------
# Set a strong 64-character secret key for production JWT token signing
JWT_SECRET=your_production_jwt_secret_key_change_in_prod_1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------- CORS Origins -----------------
# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----------------- Database -----------------
# SQLite default for dev: sqlite:///./github_ai_engineer.db
# PostgreSQL for production: postgresql://user:password@localhost:5432/github_ai_db
DATABASE_URL=sqlite:///./github_ai_engineer.db

# ----------------- Vector Database (Qdrant) -----------------
# Local storage path or leave empty for remote host
QDRANT_PATH=./qdrant_data
QDRANT_HOST=
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=code_intelligence

# ----------------- AI Services -----------------
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# ----------------- GitHub Integration -----------------
# GitHub Personal Access Token or Fine-Grained Token for PR & API access
GITHUB_TOKEN=your_github_token_here

# ----------------- Frontend Config -----------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api
